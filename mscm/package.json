{
  "name": "@mip/mscm",
  "version": "0.1.0",
  "description": "MSCM — balisage sémantique du code, index et contrôle d'intégrité. Markdown, Rust, TypeScript, Python et compagnie.",
  "license": "MIT",
  "author": "NGUYEN \"Miyukini\" Van Jean",
  "type": "module",
  "bin": {
